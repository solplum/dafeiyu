@@ -0,0 +1,31 @@
+/** Local managed policy; uses the current DSH connection.admit contract. */
+export function ownerRequestRejection(connection, req) {
+  try {
+    if (typeof connection?.admit !== 'function') return 403;
+    const admission = connection.admit(req);
+    if (!admission || typeof admission !== 'object') return 403;
+    if ('rejection' in admission) return admission.rejection === 401 ? 401 : 403;
+    if (!admission.peer || admission.peer.signal?.aborted === true
+      || admission.peer.principal?.kind !== 'owner') return 403;
+    return null;
+  } catch { return 403; }
+}
+
+export const LOGIN_IMPORT_DISABLED = Object.freeze({
+  ok: false, disabled: true, code: 'LOGIN_IMPORT_DISABLED',
+  error: 'Login import is disabled in this managed build. Log in normally in the agent browser.'
+});
+
+export function executionUnknown(result, { cancelled = false, timedOut = false } = {}) {
+  return { ...result, ok: false, code: 'EGO_EXECUTION_UNKNOWN',
+    executionState: 'unknown', retryable: false, cancelled, timedOut,
+    error: 'Browser execution was not confirmed. It was not replayed; read the current page before deciding the next action.'
+      + (result.error ? ` ${result.error}` : '') };
+}
+
+export function executionError(result) {
+  return Object.assign(new Error(result.error || 'Browser execution failed'), {
+    code: result.code, executionState: result.executionState,
+    retryable: false, cancelled: result.cancelled === true, timedOut: result.timedOut === true
+  });
+}
--- upstream/lib/worker-auth.js
+++ managed/lib/worker-auth.js
@@ -0,0 +1,22 @@
+import { randomBytes, timingSafeEqual } from 'node:crypto';
+
+export const WORKER_TOKEN_HEADER = 'x-dfy-ego-worker-token';
+export const validWorkerToken = (value) => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value);
+export const createWorkerToken = () => randomBytes(32).toString('hex');
+
+/** Called before every worker route; no token or screenshot reaches a browser client. */
+export function admitWorkerRequest(req, res, expectedToken) {
+  if (req.method === 'OPTIONS') {
+    res.writeHead(204, { 'cache-control': 'no-store' });
+    res.end();
+    return false;
+  }
+  const supplied = req.headers[WORKER_TOKEN_HEADER];
+  if (!validWorkerToken(expectedToken) || !validWorkerToken(supplied)
+    || !timingSafeEqual(Buffer.from(supplied), Buffer.from(expectedToken))) {
+    res.writeHead(403, { 'content-type': 'application/json', 'cache-control': 'no-store' });
+    res.end('{"ok":false,"error":"worker-auth-required"}');
+    return false;
+  }
+  return true;
+}
